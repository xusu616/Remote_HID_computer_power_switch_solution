PORT=9876
TOKEN=CHANGE_ME_TO_A_RANDOM_24_HEX_TOKEN
TAILSCALE_ONLY=0
# 0: HID-only, ADB disabled (recommended default)
# 1: Composite wired USB + wireless ADB + HID
# 2: Wireless-only ADB + pure wired USB HID
KEEP_ADB=0
AUTO_HID_ON_BOOT=1
# 1: run background USB HID self-healing watchdog when daemon is active; 0: disable
HID_WATCHDOG=1
# Optional overrides (leave empty to auto-detect)
UDC_NAME=
USB_CONFIG=
